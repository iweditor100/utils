generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                         String                     @id @default(uuid())
  email                      String                     @unique
  name                       String?
  picture                    String?
  emailVerifiedAt            DateTime?
  status                     UserStatus                 @default(ACTIVE)
  lastLoginAt                DateTime?
  deletedAt                  DateTime?
  createdAt                  DateTime                   @default(now())
  updatedAt                  DateTime                   @updatedAt
  adminProfile               AdminProfile?
  authAuditLogs              AuthAuditLog[]
  identities                 AuthIdentity[]
  businessAuditLogs          BusinessAuditLog[]
  calendarEvents             CalendarEvent[]
  emailVerificationTokens    EmailVerificationToken[]
  googleCalendarIntegrations GoogleCalendarIntegration?
  passwordResetTokens        PasswordResetToken[]
  refreshTokens              RefreshToken[]
  sessions                   Session[]
  serviceAreas               ServiceArea[]
  userSetting                UserSetting?
  availability               UserAvailability[]
  offDays                    UserOffDay[]

  @@index([deletedAt])
  @@map("users")
}

model AuthIdentity {
  id           String       @id @default(uuid())
  userId       String
  provider     AuthProvider
  providerId   String?
  passwordHash String?
  verifiedAt   DateTime?
  lastUsedAt   DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerId])
  @@index([userId])
  @@map("auth_identities")
}

model Session {
  id            String         @id @default(uuid())
  userId        String
  ipAddress     String?
  userAgent     String?
  deviceLabel   String?
  expiresAt     DateTime
  revokedAt     DateTime?
  createdAt     DateTime       @default(now())
  authAuditLogs AuthAuditLog[]
  refreshTokens RefreshToken[]
  user          User           @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model RefreshToken {
  id           String    @id @default(uuid())
  tokenHash    String    @unique
  userId       String
  sessionId    String?
  ipAddress    String?
  userAgent    String?
  revokedAt    DateTime?
  replacedById String?
  expiresAt    DateTime
  createdAt    DateTime  @default(now())
  session      Session?  @relation(fields: [sessionId], references: [id])
  user         User      @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([sessionId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model AuthAuditLog {
  id        String        @id @default(uuid())
  userId    String?
  adminId   String?
  event     AuthEvent
  ipAddress String?
  userAgent String?
  metadata  Json?
  createdAt DateTime      @default(now())
  sessionId String?
  admin     AdminProfile? @relation(fields: [adminId], references: [id])
  session   Session?      @relation(fields: [sessionId], references: [id])
  user      User?         @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([adminId])
  @@index([sessionId])
  @@index([createdAt])
  @@map("auth_audit_logs")
}

model BusinessAuditLog {
  id           String        @id @default(uuid())
  event        String
  actorUserId  String?
  actorAdminId String?
  actorType    String
  entityType   String
  entityId     String
  ipAddress    String?
  userAgent    String?
  metadata     Json?
  createdAt    DateTime      @default(now())
  actorAdmin   AdminProfile? @relation(fields: [actorAdminId], references: [id])
  actorUser    User?         @relation(fields: [actorUserId], references: [id])

  @@index([actorUserId])
  @@index([actorAdminId])
  @@index([entityType, entityId])
  @@index([event])
  @@index([createdAt])
  @@map("business_audit_logs")
}

model EmailVerificationToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("email_verification_tokens")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model AdminProfile {
  id                String             @id @default(uuid())
  userId            String             @unique
  role              AdminRole          @default(SUPPORT)
  permissions       Json?
  lastAccessAt      DateTime?
  revokedAt         DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  authAuditLogs     AuthAuditLog[]
  businessAuditLogs BusinessAuditLog[]

  @@map("admin_profiles")
}

model CalendarEvent {
  id                 String        @id @default(uuid())
  userId             String
  title              String
  description        String?
  location           String?
  allDay             Boolean       @default(false)
  startAt            DateTime
  endAt              DateTime
  timeZone           String
  googleEventId      String?       @unique
  googleEtag         String?
  googleHtmlLink     String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  category           EventCategory @default(PRIMARY)
  lastModifiedSource SyncSource?
  lastSyncedAt       DateTime?
  user               User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, startAt])
  @@index([googleEventId])
  @@map("calendar_events")
}

model GoogleCalendarIntegration {
  id                String   @id @default(uuid())
  userId            String   @unique
  email             String
  accessToken       String?
  refreshToken      String?
  expiryDate        BigInt?
  syncToken         String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  isSyncEnabled     Boolean  @default(false)
  webhookChannelId  String?
  webhookExpiration BigInt?
  webhookResourceId String?
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("google_calendar_integrations")
}


model ServiceArea {
  id        String   @id @default(uuid())
  userId    String
  name      String

  type      String   @default("POLYGON")

  // Polygon support
  area      Unsupported("geometry(Polygon, 4326)")?

  // Radius support
  center    Unsupported("geometry(Point, 4326)")?
  radius    Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("service_areas")
}


model UserSetting {
  id        String   @id @default(uuid())
  userId    String   @unique
  meta      Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_settings")
}

model UserAvailability {
  id        String   @id @default(uuid())
  userId    String
  dayOfWeek Int
  startTime String
  endTime   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_availability")
}

model UserOffDay {
  id        String   @id @default(uuid())
  userId    String
  date      DateTime @db.Date
  reason    String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId])
  @@map("user_off_days")
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum AuthProvider {
  GOOGLE
  EMAIL
  MAGIC_LINK
  PASSKEY
}

enum AuthEvent {
  LOGIN
  LOGOUT
  REFRESH
  TOKEN_ROTATION
  REGISTER
  EMAIL_VERIFY
  FORGOT_PASSWORD
  RESET_PASSWORD
}

enum AdminRole {
  SUPER_ADMIN
  ADMIN
  SUPPORT
}

enum EventCategory {
  PRIMARY
  SUCCESS
  WARNING
  DANGER
}

enum SyncSource {
  LOCAL
  GOOGLE
}
